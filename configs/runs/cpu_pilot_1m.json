{
  "model": {
    "vocab_size": 259,
    "hidden_size": 128,
    "intermediate_size": 256,
    "num_hidden_layers": 6,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "layer_types": [
      "full_attention",
      "sliding_attention",
      "sliding_attention",
      "full_attention",
      "sliding_attention",
      "full_attention"
    ],
    "sliding_window": 128,
    "max_position_embeddings": 512,
    "ttt_suffix_length": 1,
    "ttt_chunk_size": 8,
    "compute_dtype": "float32",
    "post_norm": false,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "pad_token_id": 0
  },
  "inner": {
    "enabled": true,
    "learning_rate": 0.1,
    "clip_norm": 1.0
  },
  "training": {
    "steps": 5000,
    "batch_size": 8,
    "sequence_length": 128,
    "warmup_steps": 200,
    "inner_warmup_steps": 0,
    "checkpoint_every": 500,
    "checkpoint_format": "npz",
    "log_every": 50,
    "seed": 0
  },
  "tokenizer": "byte"
}
