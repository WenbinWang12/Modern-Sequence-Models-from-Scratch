{
  "model": {
    "vocab_size": 259,
    "hidden_size": 384,
    "intermediate_size": 1024,
    "num_hidden_layers": 8,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "layer_types": [
      "full_attention",
      "sliding_attention",
      "sliding_attention",
      "full_attention",
      "sliding_attention",
      "sliding_attention",
      "full_attention",
      "sliding_attention"
    ],
    "sliding_window": 512,
    "max_position_embeddings": 2048,
    "ttt_suffix_length": 2,
    "ttt_chunk_size": 16,
    "compute_dtype": "bfloat16",
    "post_norm": false,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "pad_token_id": 0
  },
  "inner": {
    "enabled": true,
    "learning_rate": 0.05,
    "clip_norm": 1.0
  },
  "training": {
    "steps": 10000,
    "batch_size": 8,
    "sequence_length": 512,
    "warmup_steps": 500,
    "inner_warmup_steps": 100,
    "checkpoint_every": 1000,
    "checkpoint_format": "orbax",
    "gradient_checkpointing": true,
    "log_every": 50,
    "seed": 0
  },
  "tokenizer": "byte"
}
