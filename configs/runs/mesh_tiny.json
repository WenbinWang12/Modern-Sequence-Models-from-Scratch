{
  "model": {
    "vocab_size": 259,
    "hidden_size": 16,
    "intermediate_size": 32,
    "num_hidden_layers": 2,
    "num_attention_heads": 2,
    "num_key_value_heads": 1,
    "layer_types": ["sliding_attention", "sliding_attention"],
    "sliding_window": 16,
    "max_position_embeddings": 256,
    "num_experts": 4,
    "num_experts_per_token": 2,
    "num_shared_experts": 1,
    "moe_intermediate_size": 16,
    "first_k_dense_layers": 0,
    "ttt_suffix_length": 1,
    "ttt_chunk_size": 4,
    "compute_dtype": "float32",
    "post_norm": false
  },
  "inner": {"enabled": true, "learning_rate": 0.1, "clip_norm": 1.0},
  "training": {
    "steps": 2,
    "batch_size": 2,
    "sequence_length": 16,
    "warmup_steps": 0,
    "inner_warmup_steps": 0,
    "checkpoint_every": 2,
    "checkpoint_format": "orbax",
    "gradient_checkpointing": true,
    "parallelism": "mesh",
    "expert_parallel_size": 2,
    "log_every": 1,
    "seed": 0
  },
  "tokenizer": "byte"
}
