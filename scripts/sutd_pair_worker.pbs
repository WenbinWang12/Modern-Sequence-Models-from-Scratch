#!/usr/bin/env bash
#PBS -N ttt_pair_worker
#PBS -q v100q
#PBS -P 20260204
#PBS -l select=1:ncpus=2:ngpus=1:mem=16gb
#PBS -l walltime=00:15:00
#PBS -j oe

set -euo pipefail
ROOT="$(cd "${TTT_ROOT:-$PBS_O_WORKDIR}" && pwd -P)"
cd "$ROOT"
: "${TTT_PAIR_DIR:?}"
: "${JAX_COORDINATOR_ADDRESS:?}"
: "${JAX_PROCESS_ID:?}"
DIR="$(readlink -f "$TTT_PAIR_DIR")"
case "$DIR" in "$ROOT/results/"*) ;; *) exit 64 ;; esac
case "$JAX_PROCESS_ID" in 0|1) ;; *) exit 64 ;; esac
rank="$JAX_PROCESS_ID"
export JAX_PROCESS_COUNT=2
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_DEFAULT_MATMUL_PRECISION=highest
export PYTHONUNBUFFERED=1
exec >"$DIR/rank-$rank.log" 2>&1
hostname >"$DIR/host.$rank"
printf '%s\n' "$PBS_JOBID" >"$DIR/job.$rank"
trap 'touch "$DIR/done.$rank"' EXIT
touch "$DIR/ready.$rank"
ready=0
for ((attempt=0; attempt<300; attempt++)); do
  if [[ -f "$DIR/done.0" || -f "$DIR/done.1" ]]; then
    printf '另一进程已退出。\n' >&2
    exit 1
  fi
  if [[ -f "$DIR/ready.0" && -f "$DIR/ready.1" ]]; then
    ready=1
    break
  fi
  sleep 2
done
if [[ "$ready" != "1" ]]; then
  printf '等待另一份 PBS 分配超时。\n' >&2
  exit 1
fi
"$ROOT/.venv/bin/python" -m ttt.validate_mesh --require-gpu \
  --output "$DIR/report.json" --checkpoint-dir "$DIR"
